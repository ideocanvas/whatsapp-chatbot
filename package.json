{
  "name": "whatsapp-chatbot",
  "version": "1.0.0",
  "description": "WhatsApp Chat Bot using Facebook WhatsApp API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:lightweight": "ENABLE_NEWS_SCHEDULER=false node dist/index.js",
    "test:knowledge-search": "ts-node src/test-knowledge-search.ts",
    "news:cli": "ts-node src/commands/news-cli.ts",
    "news:cli:prod": "node dist/commands/news-cli.js",
    "web:scrape": "ts-node src/commands/web-scrape-cli.ts",
    "web:scrape:prod": "node dist/commands/web-scrape-cli.js",
    "chrome:test": "ts-node scripts/test-chrome-remote-debug.ts",
    "chrome:news": "ts-node scripts/test-chrome-news-article.ts",
    "dev": "npm run watch",
    "watch": "nodemon",
    "watch:verbose": "nodemon --verbose",
    "dev:debug": "nodemon --inspect",
    "dev:mode": "DEV_MODE=true npm run watch",
    "dev:test": "ts-node src/dev-test.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "autonomous": "ts-node src/server.ts",
    "autonomous:dev": "DEV_MODE=true ts-node src/server.ts",
    "autonomous:watch": "nodemon --exec ts-node src/server.ts",
    "web:test": "ts-node src/test-autonomous.ts",
    "react:dev": "cd frontend && npm run dev",
    "react:build": "cd frontend && npm run build",
    "react:preview": "cd frontend && npm run preview",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:chatbot": "pm2 start ecosystem.config.js --only chatbot",
    "pm2:start:news": "pm2 start ecosystem.config.js --only news-worker",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:delete": "pm2 delete all"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "facebook",
    "api",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/jsdom": "^27.0.0",
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "commander": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.4",
    "jsdom": "^27.3.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "pgvector": "^0.2.1",
    "playwright": "^1.55.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.16.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "pm2": "^5.3.0",
    "prisma": "^7.2.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
