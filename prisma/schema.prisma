generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ConversationLog {
  id          String      @id @default(uuid())
  userId      String
  message     String
  role        Role
  timestamp   DateTime
  messageType MessageType
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([role])
}

model Knowledge {
  id             String                 @id @default(uuid())
  content        String
  source         String?
  category       String?
  tags           Json?
  timestamp      DateTime
  relevanceScore Float?                 @default(0.0)
  embedding      Unsupported("vector(768)")?  // pgvector for efficient similarity search (768 dimensions)

  @@index([category])
  @@index([timestamp])
  @@index([relevanceScore])
}

model ProcessedMessage {
  messageId    String   @id
  processedAt  DateTime @default(now())
  senderNumber String?
  messageType  String?

  @@index([processedAt])
}

model ConversationSummary {
  id          String   @id @default(uuid())
  userId      String
  summary     String
  timestamp   DateTime
  contextHash String
  createdAt   DateTime @default(now())

  @@unique([userId, contextHash])
  @@index([userId])
  @@index([timestamp])
}

model UserProfile {
  userId       String    @id
  name         String?
  location     String?
  language     String?   @default("en")
  facts        Json      @default("{}")
  completeness Int       @default(0)
  lastAsked    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BlogPost {
  id            String         @id @default(uuid())
  title         String
  content       String
  excerpt       String?
  sourceUrl     String?
  sourceTitle   String?
  featuredImage String?
  imageAlt      String?
  imageCaption  String?
  tags          String[]
  category      String?
  author        String?        @default("AI Assistant")
  status        BlogPostStatus @default(draft)
  publishedAt   DateTime?
  dailyDigestId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dailyDigest   DailyDigest?   @relation(fields: [dailyDigestId], references: [id])

  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([dailyDigestId])
}

model DailyDigest {
  id             String        @id @default(uuid())
  date           DateTime      @unique
  title          String
  content        String
  weeklyDigestId String?
  createdAt      DateTime      @default(now())
  blogPosts      BlogPost[]
  weeklyDigest   WeeklyDigest? @relation(fields: [weeklyDigestId], references: [id])

  @@index([date])
  @@index([weeklyDigestId])
}

model WeeklyDigest {
  id           String        @id @default(uuid())
  startDate    DateTime
  endDate      DateTime
  title        String
  content      String
  createdAt    DateTime      @default(now())
  dailyDigests DailyDigest[]

  @@index([startDate])
  @@index([endDate])
}

model NewsSource {
  id          String         @id @default(uuid())
  url         String         @unique
  name        String?
  region      String?
  language    String?
  priority    Int            @default(0)
  isActive    Boolean        @default(true)
  sourceType  NewsSourceType @default(google_news)
  lastScraped DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([region])
  @@index([language])
  @@index([priority])
  @@index([isActive])
}

model NewsKeyword {
  id        String    @id @default(uuid())
  keyword   String
  relevance Float     @default(0.0)
  category  String?
  lastUsed  DateTime?
  createdAt DateTime  @default(now())

  @@index([keyword])
  @@index([relevance])
  @@index([category])
}

model ProcessedArticle {
  id                String                 @id @default(uuid())
  title             String
  url               String                 @unique
  source            String
  publishedAt       String
  originalContent   String
  processedContent  String
  imagePaths        String[]
  imageDescriptions Json?
  keywords          String[]
  category          String?
  processingStatus  ProcessedArticleStatus @default(pending)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  errorMessage      String?
  feedUrl           String?
  retryCount        Int                    @default(0)
  tags              String[]

  @@index([url])
  @@index([source])
  @@index([feedUrl])
  @@index([publishedAt])
  @@index([category])
  @@index([processingStatus])
  @@index([createdAt])
}

enum Role {
  user
  assistant
}

enum MessageType {
  text
  image
  audio
}

enum BlogPostStatus {
  draft
  published
  archived
}

enum NewsSourceType {
  google_news
  direct_site
  user_favorite
  discovered
}

enum ProcessedArticleStatus {
  pending
  processing
  completed
  failed
}
